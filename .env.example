# Copy to .env.local and fill in. Never commit .env.local.

# Public base URL of the app (used for the Google OAuth redirect URI).
APP_URL=http://localhost:3000

# YouCam API (https://yce.perfectcorp.com/api-console/en/api-keys/). Without a key the app runs in demo (mock) mode.
YOUCAM_API_KEY=
# Force demo mode even with a key (0 units spent): 1 = on
YOUCAM_MOCK=0
# Budget guards for a public demo
YOUCAM_DAILY_UNITS_PER_USER=80
YOUCAM_MIN_REMAINING_UNITS=60

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte key (base64) that encrypts per-user photo keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to disable photo storage entirely.
PHOTO_ENCRYPTION_KEY=

# Database: local SQLite file by default; set these for Turso (free tier) in production.
TURSO_DATABASE_URL=file:./data/dyecast.db
TURSO_AUTH_TOKEN=
