# Never upload local secrets, the local database or build output with `vercel deploy`.
# Anchored with "/" where needed: a bare "data/" would also drop src/data (goal colors, examples, shades).
.env*
!.env.example
/data/
/.cache/
/.next/
/node_modules/
/coverage/
/public/vendor/
/video/
*.tsbuildinfo
next-env.d.ts
